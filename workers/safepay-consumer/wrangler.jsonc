{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "deverve-safepay-webhook-consumer",
  "main": "./index.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deverve-production",
      "database_id": "355da876-17c4-4762-a59d-bb85f2e4551b"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "deverve-payment-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "deverve-payment-webhooks-dlq"
      }
    ]
  }
}
